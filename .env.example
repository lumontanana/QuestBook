APP_NAME=QuestBook
APP_ENV=local
LOG_LEVEL=INFO

# Milvus local por Docker Compose.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=questbook_documents

# Proveedores: openai, cohere, huggingface, jina, lmstudio, llamacpp.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=lmstudio
LLM_MODEL=local-model

# OpenAI / compatibles.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Cohere.
COHERE_API_KEY=

# Jina.
JINA_API_KEY=

# Hugging Face local/inference, segun el modelo usado.
HUGGINGFACEHUB_API_TOKEN=

# LM Studio y llama.cpp suelen exponer APIs compatibles con OpenAI.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1

DATA_DIR=./data
INGEST_ROOT=./data
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
